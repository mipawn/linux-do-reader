{
  "manifest_version": 3,
  "name": "LINUX DO 阅读器",
  "version": "1.7.0",
  "description": "增强 Linux.do 话题列表，点击话题直接阅读树状讨论，支持排序和自动分页，可切换原版。",
  "icons": { "32": "icon.png", "128": "icon.png" },
  "action": { "default_title": "打开 LINUX DO 阅读器", "default_icon": "icon.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://linux.do/*"],
    "css": ["launcher.css"],
    "js": ["forum.js", "navigation.js", "discussions.js", "scrolling.js", "reader.js"],
    "run_at": "document_start"
  }],
  "web_accessible_resources": [{
    "resources": ["reader.css", "symbols.png"],
    "matches": ["https://linux.do/*"]
  }]
}
