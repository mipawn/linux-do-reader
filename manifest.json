{
  "manifest_version": 3,
  "name": "LINUX DO 阅读器",
  "version": "1.5.0",
  "description": "在 Linux.do 使用顶部导航、双栏话题列表与逐楼带时间的回复树。",
  "icons": { "32": "icon.png", "128": "icon.png" },
  "action": { "default_title": "打开 LINUX DO 阅读器", "default_icon": "icon.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://linux.do/*"],
    "css": ["launcher.css"],
    "js": ["forum.js", "reader.js"],
    "run_at": "document_start"
  }],
  "web_accessible_resources": [{
    "resources": ["reader.css", "symbols.png"],
    "matches": ["https://linux.do/*"]
  }]
}
